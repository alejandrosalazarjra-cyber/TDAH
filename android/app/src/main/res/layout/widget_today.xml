<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:gravity="center_vertical" android:padding="14dp"
    android:background="@drawable/widget_background">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="NEUROSYNC · MI DÍA" android:textColor="#4258DB"
      android:textStyle="bold" android:textSize="12sp"/>
  <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
      android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:id="@+id/widget_count" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="0" android:textSize="32sp"
        android:textStyle="bold" android:textColor="#1B2540"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="9dp" android:text="tareas pendientes"
        android:textSize="12sp" android:textColor="#6A7893"/>
  </LinearLayout>
  <TextView android:id="@+id/widget_next_alarm" android:layout_width="match_parent"
      android:layout_height="wrap_content" android:text="◷ Próxima alarma: sin programar"
      android:textSize="12sp" android:textColor="#33466B" android:maxLines="1"/>
  <TextView android:id="@+id/widget_focus" android:layout_width="match_parent"
      android:layout_height="wrap_content" android:text="◎ Concentración: sin sesión"
      android:textSize="12sp" android:textColor="#33466B" android:maxLines="1"/>
  <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
      android:layout_height="wrap_content" android:layout_marginTop="9dp">
    <TextView android:id="@+id/widget_open_tasks" android:layout_width="0dp"
        android:layout_weight="1" android:layout_height="wrap_content"
        android:gravity="center" android:padding="8dp" android:text="Mis tareas"
        android:textStyle="bold" android:textColor="#4258DB" android:textSize="12sp"/>
    <TextView android:id="@+id/widget_open_launcher" android:layout_width="0dp"
        android:layout_weight="1" android:layout_height="wrap_content"
        android:gravity="center" android:padding="8dp" android:text="Inicio minimal"
        android:textStyle="bold" android:textColor="#4258DB" android:textSize="12sp"/>
  </LinearLayout>
</LinearLayout>